# 开发环境配置
# 后端API地址 - 请修改为你的后端服务地址
SHOPRO_DEV_BASE_URL=http://localhost:48080
# API路径
SHOPRO_API_PATH=/app-api
# 静态资源地址
SHOPRO_STATIC_URL=
# 租户ID（多租户场景使用）
SHOPRO_TENANT_ID=1
# WebSocket路径
SHOPRO_WEBSOCKET_PATH=/infra/ws
# H5地址
SHOPRO_H5_URL=http://localhost:3000
# 开发服务器端口
SHOPRO_DEV_PORT=3000
# 小程序直播开关
SHOPRO_MPLIVE_ON=false
